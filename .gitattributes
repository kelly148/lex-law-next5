# GEMINI-BUDGET-CAL-1 (Increment 1): pin the calibration fixture + generators to LF so the
# committed bytes match the LF-emitting generator and stay reproducible regardless of a
# platform's core.autocrlf. Scoped to these paths only — intentionally NOT a repo-wide
# `* text=auto`, to avoid mass line-ending renormalization of the existing tree.
tools/calibration/fixtures/synthetic_large_provision.txt text eol=lf
tools/calibration/fixtures/*.mjs text eol=lf
tools/calibration/*.mjs text eol=lf

# INSTR-1A0: prompt assets are hash-pinned (manifest SHA-256 validated at boot) — their
# bytes must be identical on every platform, so pin LF and never let autocrlf rewrite them.
prompts/** text eol=lf

# DEED-DRAFT-AGENT-1: the deed category fixture packs are parsed with literal "
" anchors and asserted
# byte-for-byte; pin them LF so autocrlf never rewrites the working tree (CI is LF, local Windows is not).
docs/deed/*.md text eol=lf
